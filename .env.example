# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys the app runs in mock mode and moves no money.

PORT=3000

# PayPal SANDBOX credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of a sandbox account that receives merchant payouts. Blank = payouts are simulated.
PAYPAL_MERCHANT_EMAIL=
# Set to "mock" to force mock mode even when credentials are present.
PAYPAL_MODE=

# Claude. Without a key a simple keyword agent is used instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "demo" to force the keyword agent even when a key is present.
AI_MODE=

# Demo conveniences
ALLOW_RESET=1
AGENT_RUNS_PER_HOUR=20

# Required with PayPal credentials. Where you open the app, so PayPal returns to the right place.
# PUBLIC_URL=http://localhost:3000

# Required with PayPal credentials: a long random secret that only you know.
# Without it anyone who finds the URL could spend the wallet.
# OWNER_KEY=
